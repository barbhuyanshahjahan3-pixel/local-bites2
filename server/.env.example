# Server
PORT=5000
NODE_ENV=development
CLIENT_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/localbites?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Cloudinary (free image storage, no credit card required)
# Get these 3 values from cloudinary.com dashboard > Home > Account Details.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Initial Super Admin (used only by the one-time seed script)
SUPER_ADMIN_EMAIL=owner@localbites.app
SUPER_ADMIN_TEMP_PASSWORD=ChangeMeOnFirstLogin!1

# Platform defaults
DEFAULT_COMMISSION_PERCENT=15
DEFAULT_DELIVERY_CHARGE=30

# Optional: if set, delivery charge distance uses Google Distance Matrix
# (real road distance). If left blank, the free Haversine straight-line
# distance is used instead — no key needed, works out of the box.
GOOGLE_MAPS_API_KEY=

# Web Push (real notifications that reach the restaurant/delivery partner's
# phone even when the app/browser is closed — Socket.IO alone can't do this,
# it only works while the tab is open and connected).
# Generate once with: npm run generate:vapid  (then also copy the public key
# into apps/restaurant/.env and apps/delivery/.env as VITE_VAPID_PUBLIC_KEY)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@localbites.app
